# Generated by Cargo
/target
**/target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# macOS
.DS_Store

# mcp/ (D3, sova-miner MCP server): keystores/state/run logs and installed
# packages are the only things excluded -- package-lock.json (and the built
# dist/, so the server is runnable without a build step) are committed.
mcp/.data/
mcp/node_modules/

# sova-in-a-box run state (logs, miner keystore, pids); safe to rm -rf
box/up/.run/
