# /etc/sova/near-da.env -- NEAR DA poster (sova-near-da.service).
# Nothing secret here: the key is /etc/sova/near-da.key.json.

# The index contract and the account that signs (the contract account
# itself: signer == receiver makes argument bytes ~11x cheaper).
SOVA_DA_CONTRACT=sova-da.testnet
SOVA_DA_ACCOUNT=sova-da.testnet

# The local node (`public` on the seeds, `local` on the keeper). Raw
# blocks, auto: debug_getRawBlock if served (SOVA_RPC_DEBUG=1), else
# rebuilt from eth_getRawTransactionByBlockHashAndIndex (local), else from
# eth_getBlockByNumber full tx objects (public). Or force debug|raw-tx|full-tx.
SOVA_DA_SOVA_RPC=http://127.0.0.1:8545
SOVA_DA_RAW_SOURCE=auto

# NEAR endpoints. Free public FastNEAR endpoints work without a key today
# (best-effort); set a keyed or own endpoint for production.
SOVA_DA_NEAR_RPC=https://rpc.testnet.fastnear.com
SOVA_DA_ARCHIVAL_RPC=https://archival-rpc.testnet.fastnear.com
SOVA_DA_BLOCK_API=https://testnet.neardata.xyz

# Cadence: a batch every 120 finalized blocks (50 min at 25 s), or after
# an hour with anything pending. Finalized = 300 blocks deep (~2 h 5 min).
SOVA_DA_MAX_BLOCKS=120
SOVA_DA_MAX_WAIT_SECS=3600
SOVA_DA_POLL_SECS=15
