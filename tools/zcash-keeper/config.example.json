{
  "rpc": "http://127.0.0.1:8545",
  "triggers": [
    {
      "name": "shielded-crossed-2M-ZEC",
      "contract": "0x0000000000000000000000000000000000000000",
      "when": { "kind": "poolCrossedAbove", "pool": "shielded", "zat": "200000000000000" }
    },
    {
      "name": "ironwood-outflow-over-100-ZEC",
      "contract": "0x0000000000000000000000000000000000000000",
      "when": { "kind": "netOutflowAbove", "pool": "ironwood", "zat": "10000000000" },
      "repeat": true
    },
    {
      "name": "busy-shielded-block",
      "contract": "0x0000000000000000000000000000000000000000",
      "when": { "kind": "statAtLeast", "stat": "shieldedTxCount", "value": 20 }
    }
  ]
}
