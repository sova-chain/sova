pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {ZcashBlocks, ZCASH_BLOCKS, SYSTEM_ADDRESS} from "../src/zcash/ZcashBlocks.sol";

/// SIP-7 §4.1 cross-check: the exact calldata the node's executor sends
/// (pinned in crates/evm/src/zcash.rs `zcash_blocks_record_calldata_is_pinned`)
/// decodes, field for field, into the record the contract stores.
contract ZcashBlocksRecordTest is Test {
    bytes constant NODE_CALLDATA = hex"";

    function test_node_calldata_records_field_for_field() public {
        vm.etch(ZCASH_BLOCKS, type(ZcashBlocks).runtimeCode);
        vm.prank(SYSTEM_ADDRESS);
        (bool ok,) = ZCASH_BLOCKS.call(NODE_CALLDATA);
        assertTrue(ok, "record reverted");
        (uint64 h, bytes32 hash) = ZcashBlocks(ZCASH_BLOCKS).latest();
        assertEq(h, 4_384_160);
        assertEq(hash, bytes32(uint256(0x5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a)));
        (bool found, ZcashBlocks.Block memory b) = ZcashBlocks(ZCASH_BLOCKS).summary(h);
        assertTrue(found);
        assertEq(b.time, 1_790_184_000);
        assertEq(b.txCount, 3);
        assertEq(b.saplingOutputs, 1);
        assertEq(b.ironwoodActions, 6);
        assertEq(b.pools[0], 1_573_837_835_978_306);
        assertEq(b.pools[5], 9_000);
        assertEq(b.deltas[5], -1_035_000);
        assertEq(b.notes[2], 354_039);
    }

    function test_node_calldata_is_system_only() public {
        vm.etch(ZCASH_BLOCKS, type(ZcashBlocks).runtimeCode);
        (bool ok,) = ZCASH_BLOCKS.call(NODE_CALLDATA);
        assertFalse(ok, "anyone but SYSTEM_ADDRESS must revert");
    }
}
