# Template for ~/.config/sova-testnet/secrets.env -- OUTSIDE the repo,
# mode 600 (the scripts refuse anything looser). Names only here; the
# values live in Rob's password manager and in that one file.
#   mkdir -p ~/.config/sova-testnet && install -m 600 /dev/null ~/.config/sova-testnet/secrets.env
# then fill it in with an editor (not with echo: shell history).

# Hetzner Cloud project "sova-testnet": Security > API Tokens, Read & Write.
HCLOUD_TOKEN=

# Cloudflare custom API token (scopes: docs/ops/testnet-launch.md, R2).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# R2 API token (R2 > Manage API tokens): Object Read & Write, bucket
# sova-testnet-dl only. Used by publish.sh (rclone on the seed host).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: alerts to a phone (Telegram @BotFather bot + your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a topic in a forum-style group (message_thread_id).
TELEGRAM_THREAD_ID=
