# infra/testnet/config.env -- the M1 public testnet's shape.
#
# Copy to config.env (git-ignored) and edit. NOTHING SECRET GOES HERE:
# tokens are read from the environment only (HCLOUD_TOKEN,
# CLOUDFLARE_API_TOKEN, ...), never from this file, never from git.
# See docs/ops/testnet-launch.md.

# ---- Release ---------------------------------------------------------------
# GitHub Release whose sova-box-bin-linux-x86_64.tar.gz the hosts install
# (built by .github/workflows/box-binaries.yml on a v* tag). SHA256SUMS is
# checked twice: the release-level file, then the tarball's own.
SOVA_RELEASE_TAG="v0.1.0"
SOVA_RELEASE_REPO="sova-chain/sova"
# Source checkout the faucet (not in the release tarball) and the
# build-from-source fallback use. Pinned to the same tag.
SOVA_SOURCE_REPO_URL="https://github.com/sova-chain/sova.git"

# Official Zebra image, run under systemd with host networking. Pin the
# digest on launch day (docker pull prints it) so every box runs the same
# bytes; snapshots must match its state format (6.3.0 = state v28).
ZEBRA_IMAGE="zfnd/zebra:6.3.0"
ZEBRA_IMAGE_DIGEST=""   # e.g. sha256:...; empty = tag only (weaker)

# ---- Consensus parameters (identical on every node in the network) ---------
# Epoch base B: the first Zcash testnet height that is a Sova epoch. Chosen
# and pinned at launch by epoch-base.sh (docs/ops/testnet-launch.md, "Pin
# B"). Every node, ours and strangers', must use the same value.
SOVA_EPOCH_BASE=""
# Emission: "flat" (a constant 6,250 SOVA per epoch) or "sip3" (SIP-3's
# schedule). Rob, 2026-09-23: flat on the public testnet; SIP-3's schedule
# is for mainnet.
SOVA_EMISSION_SCHEDULE="flat"
# SIP-6 sealer signatures, on from the reset's genesis (SIP-6 §7). 1 = on;
# 0 only to debug. Every node on the network must agree.
SOVA_SIP6=1
# SIP-7 Zcash pool state, on from the reset's genesis (Rob accepted SIP-7,
# 2026-09-23). 1 = on; 0 only to debug. Every node on the network must
# agree: it predeploys ZcashBlocks at 0x...5A01, which changes the genesis
# hash (and fork ID). bootnodes.sh publishes the hash the nodes print.
SOVA_SIP7=1
# Enodes run by someone other than us (comma-separated), added to every
# seed's bootnode list (deploy.sh) and to the published list (bootnodes.sh).
# Outside seeds are an M1 gate (docs/design/infra-m1.md); empty is fine for
# a rehearsal.
EXTRA_BOOTNODES=

# ---- Names -------------------------------------------------------------------
# Cloudflare zone and the hostnames under it. D3 is "reclaim sova.io",
# gated on ops-1; set another zone Rob controls if ops-1 isn't done.
CF_ZONE_NAME="sova.io"
RPC_HOST="rpc.testnet.sova.io"
FAUCET_HOST="faucet.testnet.sova.io"
DL_HOST="dl.testnet.sova.io"
# Grey-cloud (DNS-only) A/AAAA records: P2P is plain TCP/UDP and cannot be
# proxied, so seed IPs are public by necessity (infra-m1 §1).
SEED_HOST_PREFIX="seed"          # -> seed-1.testnet.sova.io
SEED_DOMAIN_SUFFIX="testnet.sova.io"
R2_BUCKET="sova-testnet-dl"

# ---- Hosts (Hetzner; the SSH key also serves any optional byo host) ---------
# Every resource is labelled project=$HC_PROJECT_LABEL; teardown only ever
# touches resources carrying that label.
HC_PROJECT_LABEL="sova-testnet"
HC_IMAGE="ubuntu-24.04"          # x86 only: the release ships linux-x86_64
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/sova_testnet_ed25519.pub"
SSH_PRIVATE_KEY_FILE="$HOME/.ssh/sova_testnet_ed25519"
# Who may SSH in (comma-separated CIDRs). Required; 0.0.0.0/0 is refused
# unless SOVA_ALLOW_SSH_FROM_ANYWHERE=1. provision.sh --my-ip fills it
# with this machine's current public IPv4 /32. It sets the Hetzner
# firewalls only: an (optional) byo host's firewall must allow the same
# source.
ADMIN_CIDRS=""

# name:type:location:volume_gb:role    (role = seed | rpc | faucet | keeper)
#   a Hetzner server provision.sh creates (type = cx33, cx43, ...). The
#   default: every server is on Hetzner (Rob, 2026-09-23).
# Optional, not the default: a host the kit does not create, e.g. a keeper
# on other hardware (another provider, a box you own):
# name:byo:<ipv4-or-hostname>:<disk_gb>:role[:<first-login-user>]
#   provision.sh adopts it over SSH as <first-login-user> (ubuntu on AWS)
#   and from then on it is configured exactly like a Hetzner server.
#   Nothing is created for it, and its firewall is yours. Runbook (AWS):
#   docs/ops/keeper-aws.md. <...> = pending. Offline proof:
#   test/byo-dry-run.sh.
# seed   -- zebrad (inbound 18233) + sova follow-only, P2P listening, no RPC
# rpc    -- zebrad + sova follow-only, public RPC profile on 127.0.0.1,
#           no inbound ports, cloudflared tunnel
# faucet -- zebrad + sova-faucet (its own hot key), cloudflared tunnel,
#           no inbound ports
# keeper -- disclosed keeper miner (D8): zebrad + sova in mine mode +
#           sova-miner, no inbound ports, never public
# Rob, 2026-09-23: all four servers on Hetzner (one server account; this
# replaces the earlier "keeper on AWS"), volumes 60/40/40 GB for
# seed/RPC/keeper. The faucet's 40 GB follows the same sizing (testnet
# zebrad state is 12 GB today). One server per location where possible;
# with three EU locations and four servers, the keeper shares fsn1 with
# the seed (the kit's original keeper line).
# Sizes (Rob, 2026-09-24): seed CX33 (4 vCPU / 8 GB, for many P2P peers),
# the rest CX23 (2 vCPU / 4 GB). zebrad uses ~0.2 GB RAM at tip; a new
# Hetzner account is capped at 20 shared vCPUs (this uses 10). Resize in
# place later with `hcloud server change-type` if a box runs short.
SERVERS=(
  "sova-seed-1:cx33:fsn1:60:seed"
  "sova-rpc-1:cx23:nbg1:40:rpc"
  "sova-faucet-1:cx23:hel1:40:faucet"
  "sova-keeper-1:cx23:fsn1:40:keeper"
)

# ---- Ports (host) ----------------------------------------------------------
SOVA_P2P_PORT=30303      # RLPx TCP + discv4/discv5 UDP (one shared port)
ZEBRA_P2P_PORT=18233     # Zcash testnet P2P
ZEBRA_RPC_PORT=18232     # 127.0.0.1 only
SOVA_HTTP_PORT=8545      # 127.0.0.1 only
SOVA_AUTH_PORT=8551      # 127.0.0.1 only, never proxied, never opened
FAUCET_PORT=18790        # 127.0.0.1 only

# ---- Day-one contracts (deploy-contracts.sh; docs/ops/wallets.md) ----------
# Public values only: addresses and prices, never a key. Each line keeps a
# value already exported in the environment, so one run can override it.
SOVA_CHAIN_ID=82330                 # kept at the reset (Rob, 2026-09-23); deploy-contracts.sh refuses any other
DEPLOY_CHAIN_NAME="sova-testnet"    # record: deployments/sova-testnet.json
DEPLOY_RPC=""                       # usually empty: use --via sova-rpc-1
# The throwaway deployer (keygen puts it here; outside the repo, 0600).
DEPLOYER_DIR="${DEPLOYER_DIR:-$HOME/.config/sova-testnet/deployer}"
# Ashwings / AshwingsMarket constructor values. Only the ones the built
# contracts take are required; deploy-kit.sh says which are missing.
# Treasury: Rob's own address (a multisig later). Public, fine to commit.
ASHWINGS_TREASURY="${ASHWINGS_TREASURY:-0x8d0123637062f8c15FD6AFDe6F834C85f4AfeEDE}"
ASHWINGS_ZEC_PAYEE="${ASHWINGS_ZEC_PAYEE:-tmQKm7CN5LaVg83YNRzXPLNy1qBMs8qcqNz}"   # project testnet payee (Rob, 2026-09-23); Rob's own t-address before mainnet
ASHWINGS_PRICE_WEI="${ASHWINGS_PRICE_WEI:-625000000000000000000}"   # 625 SOVA (Rob, 2026-09-23)
ASHWINGS_PRICE_ZAT="${ASHWINGS_PRICE_ZAT:-5000000}"   # 0.05 ZEC (Rob, 2026-09-23)
MARKET_FEE_BPS="${MARKET_FEE_BPS:-100}"         # 1%

# ---- Edge ------------------------------------------------------------------
# Public RPC, per client IP, in the RPC Worker (a Workers Rate Limiting
# binding; counters per Cloudflare location, like the WAF's per colo + IP).
# Over the limit: HTTP 429, a JSON-RPC error (-32005) with CORS and
# Retry-After, so browser pages back off. OPTIONS preflights don't count.
# The period must be 10 or 60 (the binding's only choices). 50 / 10 s is
# the number the WAF rule used when it covered "/".
# waf (default since 2026-09-25): the zone's WAF rule limits "/" + "/drip" per IP;
# reliable, but its 429 has no CORS header. worker: the Worker's Rate Limiting
# binding, which gives a CORS-readable 429 but proved unreliable on the live
# testnet (bursts of 150-300 from one IP passed untouched in SIN and FRA).
RPC_RATELIMIT_AT="${RPC_RATELIMIT_AT:-waf}"
RPC_RATELIMIT_REQUESTS=50
RPC_RATELIMIT_PERIOD=10
RPC_RATELIMIT_NAMESPACE_ID=82330   # account-unique; bindings sharing it share counters
# Faucet: the zone's one free-plan WAF rule (10 s period, 10 s mitigation,
# per IP + colo) on the path /drip. It runs before everything else; the
# faucet also keeps its own 24 h per-address and per-IP cooldowns.
CF_RATELIMIT_REQUESTS_PER_10S=50
# eth_sendRawTransactionSync waits for the transaction's block. Cloudflare
# cuts an origin request at ~100 s, so the Worker caps the call's timeout
# at 90 s (worker/rpc-firewall.mjs SYNC_TIMEOUT_MS); the node's own cap is
# SOVA_SEND_SYNC_TIMEOUT_SECS (300 s by default, bin/sova/src/send_sync.rs).

# ---- Checkout relayer (tools/checkout-relayer; docs/ops/testnet-launch.md) ---
# The Ashwings ZEC checkout's public relayer, a project-run courtesy service
# like the faucet, on the faucet host: it sends reserve/claim for buyers who
# hold no SOVA (it pays the gas; it can't take anything: the owl always goes
# to the order's recipient) and watches the payee t-address on the host's
# own zebrad (127.0.0.1, read-only calls) to claim paid orders. Loopback
# only; the public reaches it at CHECKOUT_HOST through the faucet host's
# tunnel (/reserve, /claim, /status only). Its hot key is made on the host
# and never leaves it (like the faucet's); deploy.sh records the address to
# fund in out/servers/<faucet>.checkout_relayer_address.
CHECKOUT_RELAYER=1
CHECKOUT_HOST="checkout.testnet.sova.io"
CHECKOUT_RELAYER_PORT=18791        # 127.0.0.1 only
# Sova RPC the relayer uses. The faucet host runs no sova-node, and the
# private hosts have no private network between them, so it uses the public
# RPC like any wallet: the relayer throttles itself to RPC_PER_10S requests
# per 10 s, under the edge's per-IP limit (RPC_RATELIMIT_REQUESTS / 10 s).
CHECKOUT_RELAYER_SOVA_RPC="https://rpc.testnet.sova.io"
CHECKOUT_RELAYER_RPC_PER_10S=30
# The page's origin (strict CORS: other origins get no grant, and their
# POSTs are refused).
CHECKOUT_RELAYER_CORS_ORIGIN="https://sova.io"
CHECKOUT_RELAYER_LISTINGS=1
# The checkout is Ashwings.zecCheckout(), read on-chain at start, with the
# Ashwings address and deploy block from deployments/$DEPLOY_CHAIN_NAME.json.
# Optional pin (the relayer refuses to start if the chain disagrees); live
# 2026-09-25: 0x3bdb5f58C0a4F3e7df6327E8c3A94F48E6eD0565.
CHECKOUT_RELAYER_CHECKOUT=""
# Node LTS major, from NodeSource's apt repo (Ubuntu 24.04 ships Node 18).
CHECKOUT_RELAYER_NODE_MAJOR=22
# Abuse limits. A buyer needs 1 reserve + 1 claim; a reload or double click
# with the same address gets the same open order back (free).
CHECKOUT_RELAYER_MAX_OPEN=20                  # its own unpaid orders at once (each holds an owl ~40 Zcash blocks)
CHECKOUT_RELAYER_RESERVE_PER_IP_PER_HOUR=3
CHECKOUT_RELAYER_RESERVE_PER_HOUR=60          # all clients
CHECKOUT_RELAYER_RESERVE_PER_MINUTE=10        # all clients
CHECKOUT_RELAYER_CLAIM_PER_IP_PER_HOUR=20
# Balance: below MIN it takes no new orders (claims of paid orders go on);
# smoke.sh and the health timer flag it below ALERT, so there is time to
# top up before buyers see a refusal. 0.1 / 1 SOVA; reserve + claim is
# ~282k gas (~2e-12 SOVA at the 7-wei base fee seen on 2026-09-25).
CHECKOUT_RELAYER_MIN_BALANCE_WEI=100000000000000000
CHECKOUT_RELAYER_ALERT_BALANCE_WEI=1000000000000000000

# Per-run keeper burn budget (zat). The burner stops itself when it is spent and
# every block is null until it is restarted. 30,000 zat/epoch (10k burn + 20k
# fee) is ~0.35 TAZ/day; 300,000,000 lasts ~9 days. Default in setup-host: 35,000,000.
KEEPER_BUDGET_ZAT="300000000"

# ---- Health alerts (host/health.sh, every 2 min; Telegram if configured) ----
# Block latency (docs/design/faster-blocks.md §4). A Sova block follows each
# Zcash block (~75 s; a 5-minute gap is normal).
# Alert when the newest Sova block is older than this many minutes. The
# alert says whether zebrad's tip is old too (Zcash slow) or not (Sova stuck).
BLOCK_AGE_ALERT_MIN=10
# Alert when this many newest blocks are all SIP-6 null blocks: the head
# moves, but nobody is burning, so no transaction can be mined (the
# 2026-09-25 keeper-budget incident). smoke.sh uses 20 too. At most 100.
NULL_RUN_ALERT=20
