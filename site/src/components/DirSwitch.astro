---
// Small cross-link between the design directions, so the owner can
// flip between them. Each page styles `.dirs` itself. block, fire and cover
// are the 2026-09-23 homepage round (docs/marketing/homepage-directions.md).
type Id = '2009' | 'terminal' | 'burn' | 'paper' | 'block' | 'fire' | 'cover';
interface Props { current: Id }
const { current } = Astro.props;
const dirs: { id: Id; href: string }[] = [
  { id: 'block', href: '/v/block' },
  { id: 'fire', href: '/v/fire' },
  { id: 'cover', href: '/v/cover' },
  { id: '2009', href: '/v/2009' },
  { id: 'terminal', href: '/v/terminal' },
  { id: 'burn', href: '/v/burn' },
  { id: 'paper', href: '/v/paper' },
];
---
<nav class="dirs" aria-label="Design directions">
  <span>Design directions:</span>
  {dirs.map((d) => d.id === current
    ? <strong aria-current="page">{d.id}</strong>
    : <a href={d.href}>{d.id}</a>)}
</nav>
