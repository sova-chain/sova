    font-weight: 700;
    font-display: optional;
    src: url('/fonts/paper-serif-bold.woff2') format('woff2');
  }
</style>

<style>
  :global(:root) {
    --desk: #d9d5cc;
    --paper: #fffefb;
    --ink: #141210;
    --ink2: #4a4640;
    --rule: #b9b3a8;
    --accent: #8a6a1f;
    --accent-bg: #f7f0de;
    --serif: 'Sova Paper Serif', 'CMU Serif', 'Latin Modern Roman', 'Computer Modern', 'Times New Roman', Times, 'Liberation Serif', serif;
    --mono: ui-monospace, Menlo, 'DejaVu Sans Mono', Consolas, monospace;
  }
  :global(body) {
    background: var(--desk);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.42;
    font-kerning: normal;
    font-variant-ligatures: common-ligatures;
  }
  :global(::selection) { background: #f4d98a; }

  /* Viewer chrome above and below the sheets */
  .chrome {
    max-width: 816px; margin: 0 auto; padding: 14px 16px 12px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    font-size: 14px; color: #5a554d;
  }
  .mark { color: #8a6a1f; display: block; }
  .foot { display: block; padding: 18px 16px 44px; font-size: 14px; }
  .foot p { margin: 0 0 6px; }
  .foot [data-placeholder] { color: #6e5418; }
  .foot a { color: #6e5418; }
  .foot :global(.dirs) { margin-top: 16px; font-size: 13px; color: #6f6a61; display: flex; gap: 10px; flex-wrap: wrap; }
  .foot :global(.dirs a) { color: #6e5418; }

  .foot .foot-pages a { color: var(--ink); }

  /* Table of contents. Wide screens: sticky, in the left margin, outside the
     sheets (the sheet column keeps its centred position, so nothing shifts).
     Narrower: hidden, and the first sheet's "Contents" disclosure takes over. */
  .toc { display: none; }
  .toc-h { margin: 0 0 6px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #6f6a61; }
  .toc-l, .toc-x { list-style: none; margin: 0; padding: 0; }
  .toc a { display: flex; gap: 0.5em; padding: 2px 0 2px 10px; border-left: 2px solid transparent; color: #5a554d; text-decoration: none; line-height: 1.3; }
  .toc-l .tn { flex: 0 0 auto; min-width: 1.4em; font-variant-numeric: tabular-nums; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current='true'] { color: var(--ink); border-left-color: #8a6a1f; }
  .toc-x { margin-bottom: 4px; }
  .toc-x a { color: #6e5418; }
  .toc-x + .toc-h, .toc-l + .toc-h { margin-top: 18px; }
  @media (min-width: 1200px) {
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 816px minmax(0, 1fr); }
    .toc {
      display: block; grid-column: 1; grid-row: 1; justify-self: end; align-self: start;
      position: sticky; top: 24px; width: calc(100% - 40px); max-width: 236px; margin-right: 24px;
      max-height: calc(100vh - 48px); overflow-y: auto; padding: 4px 0;
      font-size: 13.5px;
    }
    .doc { grid-column: 2; grid-row: 1; padding: 0; }
    .toc-m { display: none; }
  }

  /* The first sheet's Contents disclosure (below 1200px) */
  .toc-m { margin: 0 0 6px; font-size: 15px; text-align: left; hyphens: manual; }
  .toc-m summary { cursor: pointer; font-weight: 700; width: max-content; }
  .toc-m .toc-l { margin: 8px 0 4px; columns: 2; column-gap: 28px; }
  .toc-m .toc-l > li { break-inside: avoid; }
  .toc-m a { display: flex; gap: 0.5em; color: var(--ink); text-decoration: none; padding: 1px 0; }
  .toc-m a:hover { text-decoration: underline; }

  /* US Letter at 96 dpi: 816 x 1056, about an inch of margin */
  .doc { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 0 16px; }
  .sheet {
    position: relative; width: 100%; max-width: 816px; min-height: 1056px;
    background: var(--paper);
    padding: 76px 68px 96px;
    box-shadow: 0 1px 2px rgba(40, 34, 24, 0.18), 0 6px 22px rgba(40, 34, 24, 0.14);
    text-align: justify; hyphens: auto; -webkit-hyphens: auto;
  }
  .folio { position: absolute; left: 0; right: 0; bottom: 42px; text-align: center; font-size: 15px; }
  .runhead {
    position: absolute; top: 44px; left: 68px; right: 68px; margin: 0;
    display: flex; justify-content: space-between; gap: 12px;
    font-size: 13px; color: var(--ink2); border-bottom: 0.5px solid var(--rule); padding-bottom: 5px;
    text-align: left; hyphens: manual;
  }
  /* Old (v4) anchors kept as empty spans; give them the headings' offset. */
  .sheet [id] { scroll-margin-top: 16px; }

  .titleblock { text-align: center; margin: 4px 0 26px; hyphens: manual; }
  h1 { font-size: 26px; line-height: 1.2; font-weight: 700; margin: 0 0 18px; letter-spacing: -0.005em; }
  .author { margin: 0 0 4px; font-size: 17px; }
  .meta { margin: 0; font-size: 15px; }
  .plinks { margin: 14px 0 0; font-size: 15px; }
  .plinks a { color: #6e5418; text-decoration-color: #cdbf9c; text-underline-offset: 2px; }
  .plinks a:hover { color: var(--ink); }

  .abstract { margin: 0 44px 24px; font-size: 15px; line-height: 1.4; }
  .abstract p { margin: 0; text-indent: 0; }

  h2 { font-size: 18px; font-weight: 700; margin: 24px 0 7px; text-align: left; hyphens: manual; }
  h2 { scroll-margin-top: 16px; }
  p { margin: 0; }
  .sheet > p + p { text-indent: 1.5em; }
  .sheet > p a { color: #6e5418; text-decoration-color: #cdbf9c; text-underline-offset: 2px; }
  .sheet > p a:hover { color: var(--ink); }
  .noindent { margin-top: 4px; }
  code { font-family: var(--mono); font-size: 0.8em; hyphens: manual; }
  sub { font-size: 0.7em; line-height: 0; }
  sup { font-size: 0.7em; line-height: 0; }

  /* Section 6: the numbered steps, set as a hanging list */
  .steps { list-style: none; margin: 6px 0 0; padding: 0; }
  .steps li { position: relative; padding-left: 1.7em; margin: 0 0 3px; }
  .sn { position: absolute; left: 0; }

  /* Display equations */
  .eq { display: flex; align-items: center; justify-content: center; position: relative; margin: 14px 0; min-height: 3em; text-align: center; hyphens: manual; }
  .eqbody { display: inline-flex; align-items: center; gap: 0.12em; font-size: 18px; white-space: nowrap; }
  .op { margin: 0 0.22em; }
  .eqno { position: absolute; right: 0; font-size: 17px; }
  .frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 0.12em; line-height: 1.15; }
  .frac > span { padding: 0 0.15em; }
  .frac > span:first-child { border-bottom: 1px solid currentColor; }
  /* floor brackets drawn with borders: the font has no U+230A/B */
  .fl-l, .fl-r { align-self: stretch; width: 0.3em; margin: 0.05em 0.06em; border-bottom: 1px solid currentColor; }
  .fl-l { border-left: 1px solid currentColor; }
  .fl-r { border-right: 1px solid currentColor; }
  .flr { display: inline-block; line-height: 1.05; padding: 0 0.2em 0.04em; margin: 0 0.06em; border: solid currentColor; border-width: 0 1px 1px; }
  /* Cases (3): a scaled brace and two stacked rows */
  .brace { font-size: 2.6em; line-height: 1; margin: 0 0.08em 0 0.1em; transform: scaleX(0.7); }
  .cases { display: inline-flex; flex-direction: column; gap: 0.2em; text-align: left; }
  .cases > span { display: flex; gap: 1.6em; justify-content: space-between; align-items: baseline; }
  .cond { font-size: 0.92em; }
  .nw { white-space: nowrap; }

  /* Figures: line drawings in the paper's ink, one accent (the deep gold of
     the wordmark) for what the figure is about. viewBox 420 wide, shown at
     up to 480 px, so 13-unit text is about 15 px on a sheet and 11 px on a
     phone. */
  .fig { margin: 16px 0 12px; }
  .fig figcaption { font-size: 15px; line-height: 1.38; margin: 10px 6px 0; text-align: justify; }
  .fl { font-weight: 700; }
  .dia { display: block; width: 100%; max-width: 480px; height: auto; margin: 0 auto; overflow: visible; }
  .dia text { font-family: var(--serif); font-size: 13px; fill: var(--ink); }
  .dia .sm { font-size: 12px; }
  .dia .xs { font-size: 11px; fill: var(--ink2); }
  .dia .h { font-size: 12px; fill: var(--ink2); font-style: italic; }
  .dia .b { font-weight: 700; }
  .dia .it, .dia tspan.it { font-style: italic; }
  .dia .mono { font-family: var(--mono); font-size: 11.5px; }
  .dia text.g, .dia tspan.g { fill: var(--accent); }
  .dia text.dim { fill: var(--ink2); }
  .dia .bx { fill: none; stroke: var(--ink); stroke-width: 1; }
  .dia .bx.gb { stroke: var(--accent); stroke-width: 1.4; fill: var(--accent-bg); }
  .dia .bx.dash { stroke: var(--ink2); stroke-dasharray: 4 3; }
  .dia .ln { fill: none; stroke: var(--ink); stroke-width: 1; }
  .dia .ln.g { stroke: var(--accent); stroke-width: 1.3; }
  .dia .ln.dim { stroke: var(--ink2); }
  .dia .ln.dash { stroke: var(--ink2); stroke-dasharray: 3 3; }
  .dia .ln.dot { stroke: var(--ink2); stroke-dasharray: 1 3; stroke-linecap: round; }
  .dia .guide { fill: none; stroke: var(--rule); stroke-width: 0.75; stroke-dasharray: 2 3; }
  .dia .ah { fill: var(--ink); }
  .dia .ahg { fill: var(--accent); }

  /* References */
  .refs { list-style: none; margin: 0; padding: 0; font-size: 15px; line-height: 1.38; text-align: left; hyphens: manual; }
  .refs li { position: relative; margin: 0 0 5px; padding-left: 2.6em; }
  .rn { position: absolute; left: 0; }
  .refs a { color: inherit; overflow-wrap: anywhere; text-decoration-color: var(--rule); }
  .refs a:hover { color: #8a6a1f; }

  /* Narrow screens: lose the frame, keep the paper */
  @media (max-width: 860px) {
    .sheet { padding: 80px 48px 88px; min-height: 0; }
    .runhead { left: 48px; right: 48px; }
    .abstract { margin: 0 20px 24px; }
  }
  @media (max-width: 600px) {
    :global(body) { background: var(--paper); font-size: 16.5px; }
    .chrome { padding: 10px 16px; font-size: 12px; border-bottom: 1px solid #e4dfd5; }
    .doc { gap: 0; padding: 0; }
    .sheet { box-shadow: none; padding: 26px 16px 20px; text-align: left; hyphens: manual; -webkit-hyphens: manual; }
    .sheet + .sheet { border-top: 1px solid #e4dfd5; padding-top: 18px; }
    .folio, .runhead { display: none; }
    h1 { font-size: 23px; }
    .titleblock { margin-bottom: 22px; }
    .abstract { margin: 0 0 20px; font-size: 15.5px; }
    .fig figcaption { text-align: left; font-size: 14.5px; margin: 8px 0 0; }
    .toc-m .toc-l { columns: 1; }
    .plinks { font-size: 14.5px; line-height: 1.6; }
    .eqbody { font-size: 16.5px; }
    .eqno { font-size: 15px; }
    /* (3) is too wide for a phone on one line: each case's condition drops
       under its value, and the second value breaks after "SOVA,". */
    .eq.cases-eq { padding-right: 1.9em; }
    .cases-eq .eqbody { font-size: 15.5px; white-space: normal; }
    .cases { gap: 0.45em; }
    .cases > span { flex-direction: column; gap: 0.05em; }
    .cases .cond { padding-left: 1.2em; }
    .cv { display: flex; flex-wrap: wrap; column-gap: 0.3em; }
    .foot { padding-top: 16px; border-top: 1px solid #e4dfd5; }
  }
</style>

<script>
  // Table of contents: mark the section being read. The observer fires as a
  // heading crosses a line 18% down the viewport; the active entry is the last
  // heading above that line. Only aria-current changes, so nothing reflows.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.toc [data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (heads.length && 'IntersectionObserver' in window) {
    let cur: HTMLElement | undefined;
    const pick = () => {
      const line = innerHeight * 0.18;
      let best = heads[0];
      for (const h of heads) { if (h.getBoundingClientRect().top <= line) best = h; else break; }
      const a = links.get(best.id);
      if (a === cur) return;
      cur?.removeAttribute('aria-current');
      a?.setAttribute('aria-current', 'true');
      cur = a;
    };
    const io = new IntersectionObserver(pick, { rootMargin: '0px 0px -82% 0px' });
    heads.forEach((h) => io.observe(h));
    pick();
  }
</script>
