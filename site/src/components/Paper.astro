---
// Direction 4, "Paper": /v/2009 refined into an actual 2008-era cryptography
// paper. Letter-size sheets on a grey surround, Computer Modern (CMU Serif,
// subset to this page's glyphs and renamed "Sova Paper Serif" as the OFL's
// reserved-name clause asks of modified versions), justified and hyphenated, numbered
// sections, display equations and references. The figures borrow /v/terminal's
// treatment: small gold-on-black terminal panels, and they are the only motion.
// On wide screens a sticky table of contents sits in the left margin, outside
// the sheets; narrower screens get a "Contents" disclosure on the first sheet.
// Every fact is sourced in site/README.md ("Where each claim comes from").
// The subset font covers printable ASCII plus  · × Σ — ’ “ ” … → − (and
// no-break space): prose outside the terminal panels must stay inside that set.
// Section ids are stable anchors, not numbers: s1 … s10 keep the content they
// always had, and the section added in site v4 (6, contracts that see Zcash)
// is s-zcash, so s6 … s10 now read as sections 7 … 11.
import Direction from '../layouts/Direction.astro';
import DirSwitch from './DirSwitch.astro';
import { owlAscii } from '../data/owl-ascii';
import {
  EDGE_LINE, REWARD_SOVA, HALVING_EPOCHS, SLOW_START_EPOCHS, MIN_BURN_ZAT,
  transcript, footerLinks, repo, sips, WORDMARK_PATHS, twoBurnerSplit as split, sitePages as allPages,
} from '../data/sova';

interface Props {
  /** The public homepage: indexable, no design-direction switcher. */
  home?: boolean;
}
const { home = false } = Astro.props;
const TITLE = 'Sova: An EVM Chain That Can See Zcash';
// Links out of the paper: home first, then every page but this one.
const sitePages = [{ href: '/', label: 'Home' }, ...allPages.filter((p) => p.href !== '/paper')];
const owl = owlAscii('onchain-4.svg');
// Reference URL of a SIP's text on GitHub (data/sova.ts `sips[].file`).
const sipUrl = (n: number) => repo.blob(`sips/${sips.find((s) => s.n === n)!.file}`);

// Table of contents: every numbered heading on the page, in order.
const toc: { id: string; n: string; t: string; sub?: { id: string; n: string; t: string }[] }[] = [
  { id: 's1', n: '1', t: 'Introduction' },
  { id: 's2', n: '2', t: 'Burns' },
  { id: 's3', n: '3', t: 'Epochs and Sealing', sub: [
    { id: 's3-1', n: '3.1', t: 'Settlement as Withdrawals' },
    { id: 's3-2', n: '3.2', t: 'The Sealing Ladder' },
    { id: 's3-3', n: '3.3', t: 'Finality' },
  ] },
  { id: 's4', n: '4', t: 'Issuance' },
  { id: 's5', n: '5', t: 'Verification', sub: [
    { id: 's5-1', n: '5.1', t: 'Every Import Path' },
    { id: 's5-2', n: '5.2', t: 'The Tip and Late Joiners' },
  ] },
  { id: 's-zcash', n: '6', t: 'Contracts That See Zcash' },
  { id: 's6', n: '7', t: 'Networking' },
  { id: 's7', n: '8', t: 'Privacy at the Edges' },
  { id: 's8', n: '9', t: 'What Sova Is Not' },
  { id: 's9', n: '10', t: 'Running a Node' },
  { id: 's10', n: '11', t: 'Lineage' },
  { id: 'refs', n: '', t: 'References' },
];

// Figure 2 starts from a fixed, clearly simulated state so it renders without
// JS; the script then keeps it going with random burns. Zcash #103 is Sova #1,
// as in the regtest transcript (base height 103).
const demo = [
  { burns: 2, zec: '0.0213' },
  { burns: 0, zec: '0' },
  { burns: 1, zec: '0.0042' },
  { burns: 3, zec: '0.0371' },
  { burns: 1, zec: '0.0108' },
].map((d, i) => ({ ...d, z: 103 + i, s: 1 + i, k: 4 - i }));
const demoLog = [
  'zcash #106 <i>3 burns</i> 0.0371 ZEC destroyed',
  'sova  #4   sealed by rank 0  +6,250 SOVA to 3 burners',
  'zcash #107 <i>1 burn</i> 0.0108 ZEC destroyed',
  'sova  #5   sealed by rank 0  +6,250 SOVA to 1 burner',
];

// Figure 3: the two-node ladder scenario (docs/WORKPLAN.md C3,
// docs/design/gossip-v1.md "v2 as built"), as a timeline.
const ladder = [
  ['epoch E', 'ranked  r0 (w=5)  r1 (w=2)', 'rung of rank r = r x step'],
  ['t = 0', 'r0 may seal', 'r0 is frozen (SIGSTOP)'],
  ['t = step', 'r1 may seal', 'r1 seals B1, head -> B1'],
  ['later', 'r0 resumes', 'r0 seals B0 on B1’s parent'],
  ['arbiter', 'prefer (rank, hash)', 'B0 wins, head -> B0'],
  ['result', '1-block reorg, tip only', 'heights and balances converge'],
];

// Figure 4's withdrawal list: the paid amounts of Figure 4 in gwei.
const wds = [
  { i: '0', who: 'addr(r0)', gwei: '4,642,857,142,858' },
  { i: '1', who: 'addr(r1)', gwei: '1,607,142,857,142' },
];
---
<Direction
  title={TITLE}
  description="Sova is an EVM chain that can see Zcash: contracts check real ZEC payments on Zcash itself. SOVA, its gas, is mined by burning ZEC. Pre-release draft."
  theme="#d9d5cc"
  indexable={home}
>
  <link slot="head" rel="preload" href="/fonts/paper-serif-roman.woff2" as="font" type="font/woff2" crossorigin />

  <header class="chrome">
    <a href={home ? "/" : "/v/paper"} class="mark" aria-label="Sova: home">
      <svg viewBox="0 0 387 70" width="60" height="11" aria-hidden="true">
        {WORDMARK_PATHS.map((d) => <path fill="currentColor" d={d} />)}
      </svg>
    </a>
    <span>Pre-release draft. No public network yet.</span>
  </header>

  <div class="layout">
    <nav class="toc" aria-label="Contents">
      <p class="toc-h">Contents</p>
      <ol class="toc-l">
        {toc.map((s) => (
          <li>
            <a href={`#${s.id}`} data-toc={s.id}><span class="tn">{s.n}</span>{s.t}</a>
            {s.sub && <ol>{s.sub.map((x) => <li><a href={`#${x.id}`} data-toc={x.id}><span class="tn">{x.n}</span>{x.t}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
      <p class="toc-h">Elsewhere</p>
      <ul class="toc-x">
        {sitePages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>
    </nav>

  <main id="main" class="doc">
    <!-- Sheet 1 -->
    <article class="sheet" aria-label="Page 1">
      <header class="titleblock">
        <h1>{TITLE}</h1>
        <p class="author">The Sova contributors</p>
        <p class="meta">sova.io</p>
        <p class="meta">pre-release draft · September 2026</p>
        <nav class="plinks" aria-label="More about Sova">
          {sitePages.map((p, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={p.href}>{p.label}</a></>)}
        </nav>
      </header>

      <section class="abstract" aria-label="Abstract">
        <p><b>Abstract.</b> Sova is an EVM chain that can see Zcash. Every Sova
        node runs its own Zcash node, and every Sova block commits to the Zcash
        block it follows, so a contract can check that a ZEC payment was mined, and
        how deep, against Zcash itself. The ZEC stays on Zcash, in the hands of
        whoever it was paid to. The chain is issued by burn-mining: a user destroys
        ZEC on Zcash, and the next Sova block mints SOVA, the chain’s gas token, to
        that user, so every SOVA in existence traces to ZEC that was provably
        destroyed. Every node verifies every mint, and every answer about Zcash,
        against its own Zcash node. Execution is transparent; privacy stays at the
        edges, where shielded ZEC funds a payment or a burn. Sova is the
        programmable edge of the shielded pool.</p>
      </section>

      <details class="toc-m">
        <summary>Contents</summary>
        <ol class="toc-l">
          {toc.map((s) => (
            <li>
              <a href={`#${s.id}`}><span class="tn">{s.n}</span>{s.t}</a>
              {s.sub && <ol>{s.sub.map((x) => <li><a href={`#${x.id}`}><span class="tn">{x.n}</span>{x.t}</a></li>)}</ol>}
            </li>
          ))}
        </ol>
      </details>

      <h2 id="s1">1. Introduction</h2>
      <p>Shielded ZEC is digital cash: it moves with no ledger trail and no
      permission [1]. Money becomes more useful when programs can react to it: a
      sale, a swap, a subscription, an agent paying its own way. The usual route is
      to wrap ZEC onto another chain, which puts the coins in a custodian’s hands
      and leaves the contracts there blind to Zcash. Sova instead runs an EVM beside
      Zcash, with no change to Zcash. Each Sova node runs a Zcash node, so a
      contract can confirm a ZEC payment against Zcash itself (Section 6).</p>
      <p>The chain’s native asset, SOVA, pays for gas and is earned one way, by
      destroying ZEC (Sections 2 to 4). Sova runs no proof-of-work of its own. It
      is burn-mined and PoW-anchored: Zcash’s proof-of-work orders its blocks.</p>

      <h2 id="s2">2. Burns</h2>
      <p>A burn is one transparent Zcash transaction [2]. It pays at least {MIN_BURN_ZAT} zatoshis
      to <code>76a914&nbsp;00…00&nbsp;88ac</code>, a script whose key hash is twenty
      zero bytes, which no one can spend. It carries one OP_RETURN output: the magic
      “SV”, a version byte, the 20-byte EVM address to credit, and 32 upgrade-signal
      bits. Its weight is the ZEC destroyed. A malformed burn is not an error; it
      is simply not a burn. Figure 1 shows a burn becoming SOVA.</p>

      <figure class="fig" id="fig1">
        <div class="term">
          <pre id="t1"><code>{transcript.map((l) => (
            <span class={`ln ${l.k}`} data-k={l.k}><span class="on"></span><span class="off">{l.k === 'cmd' ? '$ ' : l.k === 'note' || l.k === 'mint' ? '# ' : ''}{l.t}</span></span>
          ))}</code></pre>
        </div>
        <figcaption><span class="fl">Figure 1:</span> A burn becoming SOVA on a local
        regtest network. Values from a logged run, shortened.</figcaption>
      </figure>

      <span class="folio" aria-hidden="true">1</span>
    </article>

    <!-- Sheet 2 -->
    <article class="sheet" aria-label="Page 2">
      <p class="runhead" aria-hidden="true"><i>{TITLE}</i><span>pre-release draft</span></p>

      <h2 id="s3">3. Epochs and Sealing</h2>
      <p>One Zcash block is one epoch, and each epoch gets exactly one Sova block
      [3]. From a base height <i>B</i>, the block for epoch <i>E</i> sits at Sova
      height <i>E</i>&nbsp;−&nbsp;<i>B</i>&nbsp;+&nbsp;1. The epoch’s burners rank by
      weight; the top burner seals the block, and lower ranks may seal on a timeout
      ladder if it is absent. An epoch with no burns still gets its block, and mints
      nothing (Figure 2).</p>

      <figure class="fig" id="fig2">
        <div class="term stream-wrap">
          <p class="demo-tag">DEMO · simulated · not a live network</p>
          <div class="stream" id="stream" aria-hidden="true">
            <span class="lane z">zcash</span>
            <span class="lane s">sova</span>
            <div class="cols" id="cols">
              {demo.map((d) => (
                <div class="col" style={`--k:${d.k}`}>
                  <div class="zb"><span class="n">#{d.z}</span><br />{d.burns
                    ? <><span class="b">{d.burns} burn{d.burns > 1 ? 's' : ''}</span><br />{d.zec} ZEC</>
                    : <>no burns<br />&nbsp;</>}</div>
                  <span class="link in"></span>
                  <div class={`sb in ${d.burns ? 'mint' : 'empty'}`}><span class="n">sova #{d.s}</span><br />{d.burns ? `+${REWARD_SOVA} SOVA` : '0 minted'}</div>
                </div>
              ))}
            </div>
          </div>
          <pre class="slog" id="log" aria-hidden="true" set:html={demoLog.map((l) => l.replace(/^(zcash #\d+|sova  #\d+)/, '<b>$1</b>')).join('\n')} />
        </div>
        <figcaption><span class="fl">Figure 2:</span> Each Zcash block is followed by one
        Sova block, which mints {REWARD_SOVA} SOVA if the Zcash block carried burns and
        nothing if it did not. <i>Simulated</i>: random burns, 75&nbsp;s blocks shown at
        30×.</figcaption>
      </figure>

      <h3 id="s3-1">3.1 Settlement as Withdrawals</h3>
      <p>The mint needs no new transaction type and no change to the EVM’s
      executor. An epoch’s rewards enter the chain as the block’s{' '}
      <i>withdrawals</i>, the balance-credit list Ethereum added in its Shanghai
      upgrade [5], inherited unchanged from the execution layer [3]. Withdrawal{' '}
      <i>i</i> is an index, a validator index of 0 (a reserved marker), the
      burner’s address and an amount in gwei, in rank order. The list is a pure
      function of the epoch’s burns: rank them, apply (1) and (2) of Section 4,
      emit one entry per burner (Figure 4). A block claiming epoch <i>E</i> must
      carry exactly that list; any other list makes it invalid.</p>

      <h3 id="s3-2">3.2 The Sealing Ladder</h3>
      <p>Burners rank by weight, heaviest first; equal weights go to the smaller
      txid, compared byte by byte. Rank 0 seals. If it is absent, rank <i>r</i> may
      seal once <i>r</i>&nbsp;×&nbsp;<i>step</i> has passed since the epoch became
      sealable (the draft step is 15&nbsp;s). A node that did not burn in the epoch
      never seals it. The timeouts serve liveness only, never validity or
      preference. Among an epoch’s valid blocks every node prefers the lower rank,
      then the lower block hash, so a rank-0 block that arrives late displaces an
      on-time rank-1 block (Figure 3). Such a micro-reorg is bounded to the tip
      epoch; below the tip nothing is reconsidered.</p>
      <p>No block carries a label naming its sealer. The one-tenth tip makes each
      rank’s withdrawal list distinct, so a receiver recovers the sealer’s rank
      from the withdrawals alone. The rule is <i>the relay delivers, the arbiter
      decides</i>: peers only hand over blocks, and each node’s own fork-choice
      arbiter is the only thing that moves its head.</p>

      <span class="folio" aria-hidden="true">2</span>
    </article>

    <!-- Sheet 3 -->
    <article class="sheet" aria-label="Page 3">
      <p class="runhead" aria-hidden="true"><i>{TITLE}</i><span>pre-release draft</span></p>

      <figure class="fig" id="fig3">
        <div class="term scroll-x">
          <table class="ladder">
            <caption class="sr">Sealing ladder timeline, two-node regtest scenario</caption>
            <tbody>
              {ladder.map((r, i) => <tr class={i === 0 ? 'hd' : i === ladder.length - 1 ? 'res' : ''}><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}
            </tbody>
          </table>
        </div>
        <figcaption><span class="fl">Figure 3:</span> The sealing ladder, as the
        two-node scenario in the nightly test suite runs it. Rank 1 keeps the chain
        live while rank 0 is frozen; rank 0’s late block still wins at fork choice.
        Weights as in Figure 4.</figcaption>
      </figure>

      <h3 id="s3-3">3.3 Finality</h3>
      <p>Sova’s ordering is Zcash’s. Fork choice follows each node’s own Zcash
      view, so a Zcash reorganization implies the matching Sova reorganization,
      and finality is Zcash confirmation depth [3]. When a node’s Zcash follower
      reports a reorganization, the node unwinds its expectations and candidates
      above the fork point and derives them again from the replacement chain.
      Producers never mark the tip final: “safe” trails the head by 32 epochs and
      “finalized” by 64.</p>

      <h2 id="s4">4. Issuance</h2>
      <p>The epoch reward <i>R</i> is {REWARD_SOVA} SOVA after a {SLOW_START_EPOCHS}-epoch
      slow start, like Zcash’s own launch, and it halves every {HALVING_EPOCHS} epochs,
      Zcash’s halving interval [4]. Nine tenths of <i>R</i> is shared by
      weight <i>w<sub>i</sub></i>; the remainder, one tenth plus rounding dust, tips the
      sealer. Everything is computed in gwei, so the shares sum to <i>R</i> exactly:</p>

      <div class="eq" role="math" aria-label="s sub i equals the floor of nine tenths R times w sub i over the sum of all weights">
        <span class="eqbody"><i>s<sub>i</sub></i><span class="op">=</span><span class="fl-l" aria-hidden="true"></span><span class="frac"><span>9</span><span>10</span></span><i>R</i><span class="op">·</span><span class="frac"><span><i>w<sub>i</sub></i></span><span>Σ<sub><i>j</i></sub> <i>w<sub>j</sub></i></span></span><span class="fl-r" aria-hidden="true"></span></span>
        <span class="eqno">(1)</span>
      </div>
      <div class="eq" role="math" aria-label="the sealer tip t equals R minus the sum of all shares">
        <span class="eqbody"><i>t</i><span class="op">=</span><i>R</i><span class="op">−</span><span>Σ<sub><i>i</i></sub></span><i>s<sub>i</sub></i></span>
        <span class="eqno">(2)</span>
      </div>

      <p class="noindent">For the 0-based epoch index <i>E</i>, the schedule is</p>

      <div class="eq cases-eq" role="math" aria-label="R of E equals 0.3125 times E plus 1 when E is less than 20,000, and 6,250 over 2 to the k otherwise">
        <span class="eqbody"><i>R</i>(<i>E</i>)<span class="op">=</span><span class="brace" aria-hidden="true">{'{'}</span><span class="cases"><span><span>0.3125&nbsp;(<i>E</i>&nbsp;+&nbsp;1)</span><span class="cond"><i>E</i>&nbsp;&lt;&nbsp;20,000</span></span><span><span>6,250&nbsp;/&nbsp;2<sup><i>k</i></sup></span><span class="cond">otherwise</span></span></span></span>
        <span class="eqno">(3)</span>
      </div>

      <p class="noindent">in SOVA, where the era <i>k</i> is <i>E</i> divided by
      1,680,000, rounded down. Halvings round down to whole gwei; era 42 pays 1&nbsp;gwei and era 43 pays nothing, so
      total issuance can never exceed about 20.94 billion SOVA. A burn-less epoch
      mints nothing and its reward is never made up. Fees follow EIP-1559: the base
      fee is burned, and priority fees and the tip pay sealers. Local test networks
      pay a flat <i>R</i>; the full schedule is built and switches on with the
      public testnet. Figure 4 is a two-burner epoch.</p>

      <figure class="fig" id="fig4">
        <div class="term scroll-x">
          <table class="split">
            <caption class="sr">Two-burner reward split, regtest</caption>
            <thead><tr><th scope="col">rank</th><th scope="col">weight</th><th scope="col">tip (2)</th><th scope="col">share (1)</th><th scope="col">paid, SOVA</th></tr></thead>
            <tbody>
              {split.rows.map((r) => (
                <tr><td>{r.rank}</td><td>{r.weight}</td><td>{r.tip}</td><td>{r.share}</td><td class="paid">{r.paid}</td></tr>
              ))}
            </tbody>
            <tfoot><tr><td colspan="4">total, <i>R</i></td><td class="paid sum">{split.total}</td></tr></tfoot>
          </table>
          <pre class="wds"><span class="c"># the Sova block’s withdrawals, rank order</span>
{wds.map((w) => <><span class="k">[{w.i}]</span> validator_index 0  {w.who}  <span class="v">{w.gwei}</span> gwei{'\n'}</>)}</pre>
        </div>
        <figcaption><span class="fl">Figure 4:</span> Paid amounts from a two-node regtest
        run, and the withdrawals that pay them. The 5&nbsp;:&nbsp;2 weights and the tip are
        reconstructed with (1) and (2), which reproduce the logged amounts exactly.</figcaption>
      </figure>

      <span class="folio" aria-hidden="true">3</span>
    </article>

    <!-- Sheet 4 -->
    <article class="sheet" aria-label="Page 4">
      <p class="runhead" aria-hidden="true"><i>{TITLE}</i><span>pre-release draft</span></p>

      <h2 id="s5">5. Verification</h2>
      <p>A block claiming an epoch is valid only if its withdrawals equal the
      settlement one of the epoch’s ranks would produce, as each node re-derives it
      from its own Zcash node [3]. No signature, committee or oracle vouches for a
      mint: a peer cannot mint what your own Zcash node does not justify. Burners can
      check their own burns, txid by txid, with{' '}
      <code>sova-miner report --verify-rpc</code>.</p>

      <h3 id="s5-1">5.1 Every Import Path</h3>
      <p>The check is a consensus rule. It runs in the node’s{' '}
      <code>validate_block_pre_execution</code>, which the underlying client, reth,
      calls on every path a block can take into the chain: a block delivered at
      the tip, a short gap fetched from peers, and history synced in bulk.
      Withdrawals sit in the block body, so no execution is needed to check them.
      An earlier version ran the check only on blocks delivered through the Engine
      API, which would have let a syncing node accept any mint in history. Design
      review caught that gap, and it was closed before any public network.</p>

      <h3 id="s5-2">5.2 The Tip and Late Joiners</h3>
      <p>A Sova block can legitimately arrive seconds before a node’s own Zcash
      node has the block it settles. Heights above the node’s scanned watermark
      are therefore deferred rather than rejected: such a block competes at the
      lowest trust and is ranked properly once the scan catches up. Every height at
      or below the watermark is enforced, however old, and nothing is pruned from
      the check. A node that joins late scans Zcash first and syncs Sova history
      only as far as its scan reaches, so every historical mint is checked, never
      trusted. A test node joining 150 blocks behind catches up this way and checks the oldest mint as it goes.</p>

      <h2 id="s-zcash">6. Contracts That See Zcash</h2>
      <p>Consensus already reads Zcash: every node derives each mint from its own
      Zcash node (Section 5). SIP-4 gives contracts the same view [6]. Each Sova
      block commits to the hash of the Zcash block its epoch settles, and a
      precompile answers questions about the transparent Zcash chain up to that
      block: the committed height and hash, a block’s hash and time, where a
      transaction was mined and how deep, what a transparent output pays and to
      which script, and whether a transaction is a burn. Every answer is a pure
      function of the committed chain, so two nodes that accept the same block
      compute the same answers, whatever their own Zcash tip. A node that cannot
      answer yet holds the block and retries; it never guesses. “Not found” is a
      result, the same on every honest node. Confirmations count from the
      committed block, and each contract sets its own minimum depth.</p>
      <p>Shielded amounts, recipients and memos stay private, from contracts as from
      everyone. A shielded wallet can still pay a transparent address, and that one
      output is public. That is enough to sell for ZEC: a buyer reserves an order,
      pays the seller’s own Zcash address from any wallet, and the contract delivers
      once the payment is deep enough. The ZEC goes from buyer to seller on Zcash.
      A Zcash reorganization deeper than the payment unwinds the Sova blocks built on
      it. The anchor rule is in the node; the precompile is built, in review, and
      ships with the public testnet.</p>

      <h2 id="s6">7. Networking</h2>
      <p>Nodes speak <code>sova/1</code>, an RLPx sub-protocol with three messages:{' '}
      <code>Announce</code> (height and hash, sent to every peer when a node accepts
      a block), <code>GetBlock</code> and <code>Block</code>. Blocks are pulled,
      not pushed, so a peer cannot flood a node with bodies, and no{' '}
      <code>sova/1</code> message can move a head: a received block goes through
      the same validation as any other, and only the local arbiter chooses.</p>
      <p>Peers find each other with discv4 and discv5 on one UDP port, starting
      from bootnodes that are always set explicitly, so a Sova node never falls
      back to Ethereum’s. The testnet has its own genesis, which allocates nothing
      and gives the network its own fork ID; a discovered peer joins only once its
      fork ID checks out, which keeps Sova apart from Ethereum and every other
      network built on the same client.</p>

      <span class="folio" aria-hidden="true">4</span>
    </article>

    <!-- Sheet 5 -->
    <article class="sheet" aria-label="Page 5">
      <p class="runhead" aria-hidden="true"><i>{TITLE}</i><span>pre-release draft</span></p>

      <h2 id="s7">8. Privacy at the Edges</h2>
      <p>The EVM is transparent: every call and state change is public. A burn is
      transparent too, but it can be funded by a z→t transfer out of the shielded
      pool, so the SOVA it earns need not link to an identity. Three things stay
      visible: burns from one address link to each other, the deshielding transfer
      is public, and so are payouts. A ZEC payment that a contract checks works the
      same way: the payer can fund it from the shielded pool, and only the output to
      the seller is public.</p>

      <h2 id="s8">9. What Sova Is Not</h2>
      <p>Sova is not a privacy chain and has no private smart contracts. It is not a
      Zcash L2: it has its own consensus and posts nothing to Zcash. There is no peg:
      ZEC stays on Zcash, where contracts can see it (Section 6). A planned wrapped
      ZEC would be held by NEAR’s MPC network, and called custody every time. SOVA
      is gas. It is not governance, not staking and not a claim on anything.</p>

      <h2 id="s9">10. Running a Node</h2>
      <p>One command, <code>./box/up.sh</code>, starts a regtest Zcash node, a Sova
      node and a miner on one machine. A first build from source takes 11 to 25
      minutes, depending on the machine; after that, a run mints within 30 seconds. The source and the specifications
      are public at <a href="https://github.com/sova-chain/sova">github.com/sova-chain/sova</a>, and the public testnet comes next. Ashwings (Figure 5), owls drawn entirely by their contract, will be a
      day-one mint.</p>

      <figure class="fig" id="fig5">
        <div class="term owlfig">
          <div class="sub">
            <img src="/ashwings/onchain-4.svg" width="96" height="96" alt="A gold pixel owl, as rendered by the Ashwings contract" loading="lazy" decoding="async" />
            <span class="subl">(a)</span>
          </div>
          <div class="sub">
            <pre class="owl" aria-hidden="true" set:html={owl} />
            <span class="subl">(b)</span>
          </div>
        </div>
        <figcaption><span class="fl">Figure 5:</span> An Ashwing, a fully on-chain NFT:
        (a) the SVG the contract itself returns, (b) the same 24&nbsp;×&nbsp;24 pixels as
        text. No owner, no admin key, no metadata server. Free to mint; gas is paid in SOVA.</figcaption>
      </figure>

      <h2 id="s10">11. Lineage</h2>
      <p>Sova began as an EVM chain on the OP Stack with native BTC, held under a
      single operator key. Its mainnet ran from September to November 2025, and
      the chain was then shut down. An audit of every derivable custody address
      found zero BTC remaining.</p>
      <p>The present chain keeps its predecessor’s foundation, a reth node extended
      with the chain’s own rules, and drops the OP Stack, the bridge and custody.
      A user destroys ZEC and deposits nothing, so the chain holds nothing. The
      full history is at <a href="/story">sova.io/story</a>.</p>

