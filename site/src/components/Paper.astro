</style>

<script>
  // Table of contents: mark the section being read. The observer fires as a
  // heading crosses a line 18% down the viewport; the active entry is the last
  // heading above that line. Only aria-current changes, so nothing reflows.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.toc [data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (heads.length && 'IntersectionObserver' in window) {
    let cur: HTMLElement | undefined;
    const pick = () => {
      const line = innerHeight * 0.18;
      let best = heads[0];
      for (const h of heads) { if (h.getBoundingClientRect().top <= line) best = h; else break; }
      const a = links.get(best.id);
      if (a === cur) return;
      cur?.removeAttribute('aria-current');
      a?.setAttribute('aria-current', 'true');
      cur = a;
    };
    const io = new IntersectionObserver(pick, { rootMargin: '0px 0px -82% 0px' });
    heads.forEach((h) => io.observe(h));
    pick();
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const watch = (el: Element) => {
    const s = { visible: false };
    new IntersectionObserver(([e]) => { s.visible = e.isIntersecting; }).observe(el);
    return s;
  };

  // Figure 1: type each command, print each output line, hold, clear, repeat.
  // Every line's full text is already in the DOM (a visible and a hidden half),
  // so nothing reflows while it types.
  const pre = document.getElementById('t1');
  if (pre && !reduce) {
    const lines = [...pre.querySelectorAll<HTMLElement>('.ln')].map((el) => ({
      el, k: el.dataset.k, on: el.firstElementChild as HTMLElement,
      off: el.lastElementChild as HTMLElement, t: el.textContent || '',
    }));
    const set = (l: (typeof lines)[0], n: number) => {
      l.on.textContent = l.t.slice(0, n);
      l.off.textContent = l.t.slice(n);
    };
    pre.classList.add('anim');
    const v = watch(pre);
    const idle = async () => { while (!v.visible || document.hidden) await wait(300); };
    (async () => {
      for (;;) {
        lines.forEach((l) => set(l, 0));
        await wait(500);
        for (const l of lines) {
          await idle();
          lines.forEach((o) => o.el.classList.toggle('cur', o === l));
          if (l.k === 'cmd') {
            set(l, 2);
            await wait(350);
            for (let n = 3; n <= l.t.length; n++) { set(l, n); await wait(22); }
            await wait(300);
          } else {
            set(l, l.t.length);
            await wait(l.k === 'mint' ? 200 : 420);
          }
        }
        await wait(4200);
      }
    })();
  }

  // Figure 2: simulated block stream, labelled DEMO on the page. It starts
  // from the server-rendered columns and adds a Zcash block every 2.5 s, then
  // its Sova block. Reduced motion: the static columns stay as they are.
  const stream = document.getElementById('stream');
  const cols = document.getElementById('cols');
  const log = document.getElementById('log');
  if (stream && cols && log && !reduce) {
    const live = [...cols.children] as HTMLElement[];
    const lines = log.innerHTML.split('\n');
    let zh = 108, sh = 6;
    const addLog = (s: string) => {
      lines.push(s);
      while (lines.length > 4) lines.shift();
      log.innerHTML = lines.join('\n');
    };
    const tick = () => {
      const burns = Math.random() < 0.72 ? 1 + ((Math.random() * 4) | 0) : 0;
      const zec = burns ? (burns * (0.001 + Math.random() * 0.02)).toFixed(4) : '0';
      const pl = (n: number, w: string) => `${n} ${w}${n > 1 ? 's' : ''}`;
      const col = document.createElement('div');
      col.className = 'col';
      col.style.setProperty('--k', '0');
      col.innerHTML =
        `<div class="zb new"><span class="n">#${zh}</span><br>${burns ? `<span class="b">${pl(burns, 'burn')}</span><br>${zec} ZEC` : 'no burns<br>&nbsp;'}</div>` +
        `<span class="link"></span>` +
        `<div class="sb new ${burns ? 'mint' : 'empty'}"><span class="n">sova #${sh}</span><br>${burns ? '+6,250 SOVA' : '0 minted'}</div>`;
      live.forEach((c, i) => c.style.setProperty('--k', String(live.length - i)));
      cols.appendChild(col);
      live.push(col);
      const w = parseFloat(getComputedStyle(stream).getPropertyValue('--cw')) || 124;
      const max = Math.ceil(stream.clientWidth / w) + 1;
      while (live.length > max) live.shift()!.remove();
      const z = zh, s = sh;
      addLog(`<b>zcash #${z}</b> ${burns ? `<i>${pl(burns, 'burn')}</i> ${zec} ZEC destroyed` : 'no burns'}`);
      setTimeout(() => {
        col.querySelector('.link')!.classList.add('in');
        col.querySelector('.sb')!.classList.add('in');
        addLog(burns
          ? `<b>sova  #${String(s).padEnd(3)}</b> sealed by rank 0  +6,250 SOVA to ${pl(burns, 'burner')}`
          : `<b>sova  #${String(s).padEnd(3)}</b> empty epoch, 0 minted`);
      }, 900);
      zh++; sh++;
    };
    const v = watch(stream);
    setInterval(() => { if (v.visible && !document.hidden) tick(); }, 2500);
  }
</script>
