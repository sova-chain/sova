---
// Live testnet stats for the homepage directions: Sova height, anchored Zcash
// height, age of the last block. scripts/testnet-stats.ts fills each
// data-stat={key} in the browser from the public RPC (two calls on load,
// then every 10 s while the tab is visible); the `------` placeholders stay with no JS or when the RPC can't be
// read. Colours and font come from the page through custom properties:
// --ts-fg, --ts-dim, --ts-accent, --ts-line, --ts-font.
import { testnetStats, SOVA_RPC } from '../data/sova';

interface Props {
  /** Heading above the numbers, in the page's voice ("" for none). */
  label?: string;
}
const { label = 'testnet, live' } = Astro.props;
const host = new URL(SOVA_RPC).host;
---
<section class="ts" aria-label="Testnet stats" data-rpc={SOVA_RPC}>
  {label && <p class="ts-h"><span class="ts-dot" aria-hidden="true"></span>{label}</p>}
  <dl class="ts-grid">
    {testnetStats.map((s) => (
      <div class="ts-cell">
        <dt>{s.label}</dt>
        <dd data-stat={s.key}><span class="ts-ph" aria-hidden="true">------</span><span class="sr">not read yet</span></dd>
      </div>
    ))}
  </dl>
  <p class="ts-note">read live from {host}</p>
</section>

<script>
  import '../scripts/testnet-stats';
</script>

<style>
  .ts {
    --fg: var(--ts-fg, #fbf3dc);
    --dim: var(--ts-dim, #8a6a1f);
    --accent: var(--ts-accent, #f4b728);
    --line: var(--ts-line, #3a2f18);
    font-family: var(--ts-font, 'Roboto Mono', ui-monospace, Menlo, Consolas, monospace);
    color: var(--fg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 12px 0 10px;
    margin: 0;
  }
  .ts-h { margin: 0 0 8px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  .ts-dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    border: 1px solid var(--dim); margin-right: 8px; vertical-align: 1px;
  }
  .ts[data-live='1'] .ts-dot { background: var(--accent); border-color: var(--accent); }
  .ts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 16px; margin: 0; }
  .ts-cell { min-width: 0; }
  .ts dt { font-size: 12px; color: var(--dim); margin: 0 0 2px; }
  .ts dd { margin: 0; font-size: clamp(15px, 4.6vw, 26px); line-height: 1.2; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--accent); }
  .ts-ph { color: var(--dim); letter-spacing: 0.06em; animation: ts-wait 2.4s ease-in-out infinite; }
  .ts-cell:nth-child(2) .ts-ph { animation-delay: 0.3s; }
  .ts-cell:nth-child(3) .ts-ph { animation-delay: 0.6s; }
  @keyframes ts-wait { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  .ts-note { margin: 8px 0 0; font-size: 12px; color: var(--dim); }
  /* A value that just changed (a new block) flashes once. */
  .ts :global(dd.ts-new) { animation: ts-new 1.2s ease-out; }
  @keyframes ts-new { 0% { color: var(--fg); text-shadow: 0 0 12px var(--accent); } 100% { text-shadow: none; } }
  @media (prefers-reduced-motion: reduce) {
    .ts-ph { animation: none; opacity: 0.8; }
    .ts :global(dd.ts-new) { animation: none; }
  }
</style>
