---
// The homepage (Rob picked direction C, "Cover", 2026-09-23; the preview
// stays at /v/cover). The whole homepage is the
// cover sheet of a paper: title, a two-sentence abstract, one figure that
// draws itself (the two chains, one Sova block per Zcash block), a table for
// the live testnet numbers, and the links set as a table of contents. Set in
// the paper's Computer Modern subset (printable ASCII plus · × Σ — ’ “ ” … →
// − and no-break space; keep every rendered character inside it). CSS-only
// motion (stroke-dashoffset); reduced motion shows the finished drawing.
//
// Facts: positioning.md (Act II headline "the EVM that reads Zcash"),
// sips/sip-4-draft-zcash-state-precompile.md (§1, §12: every node runs a
// Zcash node, contracts read Zcash through it), sips/sip-3.md (SOVA minted
// only by burns), sips/sip-2.md (one Sova block per Zcash block; each block
// commits to the Zcash block it settles). Sources: site/README.md.
import Direction from '../layouts/Direction.astro';
import TestnetStats from '../components/TestnetStats.astro';
import { WORDMARK_PATHS, coverToc as toc, footerLinks } from '../data/sova';

// Table of contents (coverToc in src/data/sova.ts): Why, Mine, Run a node,
// Build, Ecosystem, GitHub, Contributing, Whitepaper, SIPs.

// Figure 1: five Zcash blocks, five Sova blocks, an anchor from each Sova
// block up to its Zcash block. Drawn in order, one pair at a time.
const N = 5;
const X0 = 66, STEP = 58, W = 34;
const pairs = Array.from({ length: N }, (_, i) => ({ x: X0 + i * STEP, i }));
---
<Direction
  title="Sova: the EVM that reads Zcash"
  description="The EVM that reads Zcash. An EVM sidechain whose every node runs a Zcash node; its gas, SOVA, is issued only by burning ZEC. Permissionless, verifiable, self-custody."
  theme="#d9d5cc"
  indexable
>
  <link slot="head" rel="preload" href="/fonts/paper-serif-roman.woff2" as="font" type="font/woff2" crossorigin />

  <main id="main" class="desk">
    <article class="sheet">
      <p class="mark">
        <svg viewBox="0 0 387 70" width="66" height="12" role="img" aria-label="Sova">
          {WORDMARK_PATHS.map((d) => <path fill="currentColor" d={d} />)}
        </svg>
      </p>

      <header class="titleblock">
        <h1>The EVM that reads Zcash.</h1>
        <p class="author">Sova</p>
        <p class="meta">sova.io · pre-release</p>
      </header>

      <p class="abstract"><b>Abstract.</b> Sova is an EVM sidechain whose every node runs a Zcash node, so a contract
        can check a ZEC payment against Zcash itself. Its gas, SOVA, is issued only by burning ZEC, one Sova block
        per Zcash block.</p>
      <p class="props"><i>Permissionless. Verifiable. Self-custody.</i></p>

      <figure class="fig">
        <svg viewBox="0 0 360 150" role="img" aria-labelledby="f1-t">
          <title id="f1-t">Two rows of blocks. Each Zcash block above has one Sova block below it, anchored to it by a line, drawn one pair at a time.</title>
          <text x="8" y="44" class="lab">Zcash</text>
          <text x="8" y="120" class="lab">Sova</text>
          {pairs.map((p) => (
            <g class="pair" style={`--i:${p.i}`}>
              <rect class="d z" x={p.x} y="24" width={W} height={W} pathLength="1" />
              {p.i > 0 && <line class="d lk" x1={p.x - STEP + W} y1="41" x2={p.x} y2="41" pathLength="1" />}
              <line class="d an" x1={p.x + W / 2} y1="58" x2={p.x + W / 2} y2="100" pathLength="1" />
              <rect class="d s" x={p.x} y="100" width={W} height={W} pathLength="1" />
              {p.i > 0 && <line class="d lk" x1={p.x - STEP + W} y1="117" x2={p.x} y2="117" pathLength="1" />}
            </g>
          ))}
          <text x={X0 + N * STEP - 14} y="46" class="dots">…</text>
          <text x={X0 + N * STEP - 14} y="122" class="dots">…</text>
        </svg>
        <figcaption><b>Figure 1.</b> One Sova block per Zcash block. Each Sova block commits to the Zcash block it settles.</figcaption>
      </figure>

      <div class="tbl">
        <p class="cap"><b>Table 1.</b> The public testnet, live.</p>
        <TestnetStats label="" />
      </div>

      <nav class="toc" aria-label="Contents">
        <p class="toc-h">Contents</p>
        <ol>
          {toc.map((t, i) => (
            <li><a href={t.href}><span class="tn">{i + 1}</span><span class="tl">{t.label}</span><span class="lead" aria-hidden="true"></span><span class="tw">{t.where}</span></a></li>
          ))}
        </ol>
      </nav>
    </article>

    <footer class="foot">
      <p>
        {footerLinks.map((p, i) => <>{i > 0 && ' · '}{p.href ? <a href={p.href}>{p.label}</a> : <span aria-disabled="true" data-placeholder={p.key}>{p.label}</span>}</>)}
      </p>
      <p>MIT or Apache-2.0. Set in Computer Modern (a subset of CMU Serif, <a href="/fonts/LICENSE-CMU-Serif.txt">SIL OFL</a>).</p>
    </footer>
  </main>
</Direction>

<style is:global>
  @font-face {
    font-family: 'Sova Paper Serif';
    font-style: normal;
    font-weight: 400;
    font-display: optional;
    src: url('/fonts/paper-serif-roman.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Sova Paper Serif';
    font-style: italic;
    font-weight: 400;
    font-display: optional;
    src: url('/fonts/paper-serif-italic.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Sova Paper Serif';
    font-style: normal;
    font-weight: 700;
    font-display: optional;
    src: url('/fonts/paper-serif-bold.woff2') format('woff2');
  }
</style>

<style>
  :global(:root) {
    --desk: #d9d5cc;
    --paper: #fffefb;
    --ink: #141210;
    --ink2: #4a4640;
    --rule: #b9b3a8;
    --accent: #8a6a1f;
    --serif: 'Sova Paper Serif', 'CMU Serif', 'Latin Modern Roman', 'Computer Modern', 'Times New Roman', Times, serif;
    --ts-fg: #141210;
    --ts-dim: #6f6a61;
    --ts-accent: #141210;
    --ts-line: #b9b3a8;
    --ts-font: var(--serif);
  }
  :global(body) {
    background: var(--desk); color: var(--ink);
    font: 16px/1.42 var(--serif); font-kerning: normal;
  }
  :global(::selection) { background: #f4d98a; }
  a { color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--rule); }
  a:hover { text-decoration-color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .desk { padding: 24px 12px 0; }
  .sheet {
    max-width: 640px; margin: 0 auto; background: var(--paper);
    padding: 44px 56px 40px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12), 0 8px 28px rgba(0, 0, 0, 0.1);
  }
  .mark { margin: 0 auto 30px; width: max-content; color: var(--accent); }

  .titleblock { text-align: center; margin: 0 0 22px; }
  h1 { font-size: clamp(27px, 5.6vw, 38px); line-height: 1.15; font-weight: 400; margin: 0 0 14px; letter-spacing: -0.005em; }
  .author { margin: 0 0 2px; font-size: 17px; }
  .meta { margin: 0; font-size: 14px; color: var(--ink2); }

  .abstract { margin: 0 auto 8px; max-width: 34em; font-size: 15px; text-align: justify; hyphens: auto; }
  .props { text-align: center; margin: 0 0 22px; }

  .fig { margin: 0 0 22px; }
  .fig svg { width: 100%; height: auto; max-width: 440px; margin: 0 auto; }
  .fig figcaption { font-size: 14px; text-align: center; margin-top: 4px; }
  .lab { font: italic 13px var(--serif); fill: var(--ink); }
  .dots { font: 16px var(--serif); fill: var(--ink2); }
  .d { fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .s { stroke: var(--accent); }
  .an { stroke-width: 1; }
  .lk { stroke: var(--ink2); }
  /* Draw one pair every 1.1 s: Zcash block, anchor, Sova block. 10 s loop. */
  @media (prefers-reduced-motion: no-preference) {
    .d { animation: draw 10s linear infinite backwards; }
    .z { animation-delay: calc(var(--i) * 1.1s); }
    .an { animation-delay: calc(var(--i) * 1.1s + 0.35s); }
    .s { animation-delay: calc(var(--i) * 1.1s + 0.55s); }
    .lk { animation-delay: calc(var(--i) * 1.1s - 0.2s); }
  }
  @keyframes draw {
    0% { stroke-dashoffset: 1; opacity: 1; }
    6% { stroke-dashoffset: 0; }
    88% { stroke-dashoffset: 0; opacity: 1; }
    96%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  .tbl { margin: 0 0 24px; }
  .cap { font-size: 14px; text-align: center; margin: 0 0 6px; }

  .toc-h { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink2); margin: 0 0 6px; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc a { display: flex; align-items: baseline; gap: 0.5em; padding: 3px 0; text-decoration: none; }
  .toc a:hover .tl { text-decoration: underline; text-decoration-color: var(--accent); }
  .tn { min-width: 1.3em; font-variant-numeric: tabular-nums; }
  .lead { flex: 1 1 auto; border-bottom: 1px dotted var(--rule); transform: translateY(-4px); min-width: 1em; }
  .tw { color: var(--ink2); font-size: 14px; text-align: right; white-space: nowrap; }

  .foot { max-width: 640px; margin: 0 auto; padding: 18px 4px 40px; font-size: 14px; color: #5a554d; }
  .foot p { margin: 0 0 6px; }
  .foot a { color: #6e5418; }
  .foot [data-placeholder] { color: #6e5418; }
  .foot :global(.dirs) { margin-top: 14px; font-size: 13px; color: #6f6a61; display: flex; gap: 10px; flex-wrap: wrap; }
  .foot :global(.dirs a) { color: #6e5418; }

  @media (max-width: 600px) {
    .desk { padding: 0; }
    .sheet { padding: 28px 16px 28px; box-shadow: none; }
    .abstract { text-align: left; }
    .tw { font-size: 13px; }
  }
</style>
