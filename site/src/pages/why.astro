---
// Why Sova: who it is for, how it compares with wrapped ZEC, what makes it
// open, and what is new (each new thing linked to where the paper shows it).
// Site v4: contracts that read Zcash lead, burn-mining second; positive
// framing (Rob, 2026-09-23). Sources: docs/marketing/{positioning,angles,
// agent-keeper}.md, docs/ROADMAP.md, sips/sip-{1,2,3,4}*.md, the paper's own
// sources. Every claim is in site/README.md. The "what it isn't" list lives
// on /press.
//
// Fair launch, experiment and the plan (Rob, 2026-09-23): the fair-launch
// section says what Sova doesn't have, plainly, the one place the site
// describes Sova by negatives. Sources: sips/sip-3.md (SOVA minted only by
// burns), bin/sova/src/chain.rs (`testnet_genesis_alloc_is_empty`),
// docs/ROADMAP.md ("What we won't do"). Dates are Rob's targets.
import Site from '../layouts/Site.astro';
import Tag from '../components/Tag.astro';

const who = [
  { h: 'ZEC holders.', t: 'Spend ZEC on contracts from the wallet you already use, shielded balance included. Or burn some and mine SOVA.' },
  { h: 'Builders.', t: 'Contracts that verify ZEC payments, with Solidity and standard EVM tooling.' },
  { h: 'Miners.', t: 'Any amount of ZEC mines. A laptop is enough.' },
  { h: 'Agents.', t: 'Give an agent a budget and it mines its own gas.' },
];

const wrapped = [
  'An IOU. The ZEC sits with a custodian, and the token is only as good as the custodian.',
  'It lives on someone else’s chain, under their upgrade keys.',
];
const sova = [
  'Contracts read Zcash itself: every node runs its own Zcash node.',
  'Self-custody. ZEC stays on Zcash, and SOVA is created by destroying ZEC.',
  'Blocks follow Zcash’s proof-of-work, one for one.',
  'Every node recomputes every mint from its own Zcash node.',
];

const fair = [
  { h: 'No premine.', t: 'The genesis allocates nothing. The testnet’s is empty, and a test checks it. Mainnet’s will be too.' },
  { h: 'No allocation.', t: 'Investors and the team get none.' },
  { h: 'Nothing in escrow.', t: 'No treasury.' },
];

const plan = [
  { when: 'now', h: 'Public testnet.', t: 'Live, mined with testnet ZEC.' },
  { when: 'Q1 2027', h: 'Mainnet.', t: 'Expected.' },
];

const grassroots = [
  { h: 'Anyone can mine, in any amount.', t: 'From 1,000 zatoshis up. Mining is burning.' },
  { h: 'Every node verifies every mint.', t: 'Against its own Zcash node, history included.' },
  { h: 'Rules change in the open.', t: 'Through SIPs, in the repository.' },
  { h: 'Runs on a laptop and an SSD.', t: 'A full Zcash node and a full Sova node, on one machine.' },
];

const fresh = [
  { h: 'Contracts that read Zcash.', t: 'A contract verifies that a ZEC payment landed, and how deep, then acts: a sale, a swap, a mint.', proof: 'paper §8', href: '/paper#reading-zcash', k: 'testnet' },
  { h: 'Burn-mining.', t: 'Issuance comes only from destroyed ZEC, split among that epoch’s burners.', proof: 'paper §4', href: '/paper#issuance' },
  { h: 'Anchored to Zcash.', t: 'One Sova block per Zcash block, ordered by Zcash’s proof-of-work.', proof: 'paper §3', href: '/paper#epochs' },
  { h: 'Every node checks every mint.', t: 'Against its own Zcash node, synced history included.', proof: 'paper §7', href: '/paper#verification' },
  { h: 'The sealer ladder.', t: 'The top burner seals each block. If it is offline, the next in line seals after a short delay.', proof: 'paper §5', href: '/paper#sealing' },
  { h: 'Its own network protocol.', t: 'Peers announce and serve blocks. Only your own node moves its head.', proof: 'paper §6', href: '/paper#network' },
  { h: 'Mining by agent.', t: 'An MCP server gives an agent six tools and a hard budget.', proof: 'mine', href: '/mine#agent' },
];
---
<Site
  title="Why Sova"
  description="Sova is an EVM chain that reads Zcash: contracts verify ZEC payments on Zcash itself. It is mined by burning ZEC, ordered by Zcash’s proof-of-work, and runs on a laptop."
  current="/why"
  cmd="sova --why"
  status="pre-release · public testnet live"
>
  <h1>Why Sova</h1>
  <p class="lead">Sova is an EVM chain whose contracts read Zcash: they verify ZEC payments on Zcash itself. It is mined by burning ZEC and ordered by Zcash’s proof-of-work.</p>

  <h2>who it’s for</h2>
  <ul class="rows">
    {who.map((r) => <li><span class="mk">&gt;</span><p><b>{r.h}</b> {r.t}</p></li>)}
  </ul>

  <h2>fair launch</h2>
  <ul class="rows fair">
    {fair.map((r) => <li><span class="mk">[0]</span><p><b>{r.h}</b> {r.t}</p></li>)}
  </ul>
  <p class="edge">SOVA is created only by producing blocks. Whoever produces blocks earns it.</p>
  <p class="note"># The local box prefunds throwaway dev accounts. They never exist on a public network.</p>

  <h2>wrapped ZEC, or Sova</h2>
  <div class="diff">
    <p class="dh old">wrapped ZEC</p>
    <ul>{wrapped.map((t) => <li class="old"><span class="mk">-</span><p>{t}</p></li>)}</ul>
    <p class="dh new">Sova</p>
    <ul>{sova.map((t) => <li class="new"><span class="mk">+</span><p>{t}</p></li>)}</ul>
  </div>
  <p>Contracts that read Zcash: <Tag k="testnet" /> built, in review. Contracts that watch Zcash’s value pools: <Tag k="planned" /> <a href="/sips#sip-7">SIP-7</a>.</p>

  <h2>open</h2>
  <ul class="rows">
    {grassroots.map((r) => <li><span class="mk">[x]</span><p><b>{r.h}</b> {r.t}</p></li>)}
  </ul>

  <h2>what’s new</h2>
  <ol class="reasons">
    {fresh.map((r, i) => (
      <li>
        <span class="n">[{String(i + 1).padStart(2, '0')}]</span>
        <div>
          <p class="rh">{r.h} {r.k && <Tag k={r.k} />}</p>
          <p class="rt">{r.t} <a class="proof" href={r.href}>→ {r.proof}</a></p>
        </div>
      </li>
    ))}
  </ol>

  <p class="edge">The EVM is public. Privacy is at the funding edge: fund your burn from the shielded pool and the ledger does not link the SOVA to you. <a class="proof" href="/paper#privacy">→ paper §9</a></p>

  <h2>an experiment</h2>
  <p class="warn">Sova is an experiment: pre-release and unaudited. The code and the specs still change, and testnet state gets reset.</p>

  <h2>the plan</h2>
  <ol class="plan">
    {plan.map((r) => <li><span class="when">[{r.when}]</span><p><b>{r.h}</b> {r.t}</p></li>)}
  </ol>
  <p class="note"># Dates are targets.</p>

  <p>Where Sova came from: <a href="/story">the story</a>.</p>

  <p class="next"><a href="/paper">Read the whitepaper</a><a href="/build">Build</a><a href="/mine">Mine</a><a href="/story">The story</a></p>
</Site>

<style>
  .rows, .diff ul { list-style: none; padding: 0; margin: 0 0 14px; }
  .rows li, .diff li { display: grid; grid-template-columns: 4ch 1fr; gap: 8px; margin: 0 0 8px; max-width: none; }
  .rows li p, .diff li p { margin: 0; }
  .rows .mk { color: var(--g3); }
  .rows b { color: var(--g); font-weight: 700; }

  .diff { background: #110e09; border: 1px solid var(--line); border-left: 2px solid var(--g2); padding: 12px 14px 4px; margin: 0 0 16px; max-width: 76ch; }
  .diff .dh { margin: 0 0 6px; font-size: 13.5px; }
  .diff .dh::before { content: '@@ '; color: var(--g3); }
  .diff .dh::after { content: ' @@'; color: var(--g3); }
  .diff .dh.old { color: var(--ember); }
  .diff .dh.new { color: var(--g); }
  .diff li.old .mk { color: var(--ember); }
  .diff li.new .mk { color: var(--g); }
  .diff li.new p { color: var(--cream); }

  .reasons { list-style: none; padding: 0; margin: 0; }
  .reasons li { display: grid; grid-template-columns: 7ch 1fr; gap: 12px; padding: 14px 0; border-top: 1px dashed var(--line); max-width: none; }
  .reasons li:last-child { border-bottom: 1px dashed var(--line); }
  .n { color: var(--g3); }
  .rh .st { font-weight: 400; margin-left: 4px; }
  .rh { color: var(--g); font-weight: 700; margin: 0 0 3px !important; font-size: 16px; }
  .rt { margin: 0 !important; }
  .proof { white-space: nowrap; font-size: 13px; margin-left: 4px; }

  .fair .mk { color: var(--g); }
  .note { color: var(--g3); font-size: 13.5px; margin: 0 0 16px !important; }
  .fair + .edge { margin: 4px 0 8px !important; }
  .warn { padding: 10px 14px; border-left: 2px solid var(--ember); background: rgba(194, 90, 51, 0.06); color: var(--cream); max-width: 76ch; }
  .plan { list-style: none; padding: 0; margin: 0 0 8px; }
  .plan li { display: grid; grid-template-columns: 11ch 1fr; gap: 10px; margin: 0 0 8px; max-width: none; }
  .plan li p { margin: 0; }
  .plan .when { color: var(--g3); white-space: nowrap; }
  .plan b { color: var(--g); font-weight: 700; }
  .edge { margin: 26px 0 40px !important; padding: 10px 14px; border-left: 2px solid var(--g); background: rgba(244, 183, 40, 0.04); color: var(--cream); }

  @media (max-width: 600px) {
    .rows li, .diff li { grid-template-columns: 3ch 1fr; gap: 6px; }
    .reasons li { grid-template-columns: 6ch 1fr; gap: 8px; }
    .plan li { grid-template-columns: 10ch 1fr; gap: 6px; }
    .rh { font-size: 15px; }
    .diff { padding: 10px 10px 2px; }
  }
</style>
